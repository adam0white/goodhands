{
  "name": "goodhands",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Good Hands: a month running a small placement agency, where nobody is quite who they say at interview.",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/stamp-release.ts && vite build",
    "preview": "vite preview",
    "test": "vitest run --no-file-parallelism --testTimeout=180000",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome format --write .",
    "measure": "node scripts/measure.ts",
    "check": "npm run lint && npm run typecheck && npm test",
    "deploy": "npm run check && npm run build && wrangler deploy",
    "check:lane": "node scripts/suite-lock.ts -- npm run check"
  },
  "dependencies": {
    "@adam0white/human-framework": "2.18.0",
    "@adam0white/human-framework-legacy": "npm:@adam0white/human-framework@2.9.0",
    "@adam0white/lab-client": "file:vendor/adam0white-lab-client-0.4.6.tgz",
    "@adam0white/lab-kit": "file:vendor/adam0white-lab-kit-0.5.6.tgz"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "26.6.5",
    "playwright-core": "^1.64.1",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "wrangler": "4.151.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261019.1": true,
    "fsevents": false
  },
  "overrides": {
    "sharp": "0.35.5",
    "miniflare": {
      "undici": "7.30.1"
    }
  }
}
