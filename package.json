{
  "name": "goodhands",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Good Hands: a month running a small placement agency, where nobody is quite who they say at interview.",
  "license": "MIT",
  "engines": {
    "node": "26.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/stamp-release.ts && vite build",
    "preview": "vite preview",
    "test": "vitest run --no-file-parallelism --testTimeout=180000",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome format --write .",
    "measure": "node scripts/measure.ts",
    "check": "npm run lint && npm run typecheck && npm test",
    "deploy": "pnpm run check:lane && pnpm run build && pnpm exec wrangler deploy",
    "check:lane": "npm run lint && npm run typecheck"
  },
  "dependencies": {
    "@adam0white/human-framework": "4.7.0",
    "@adam0white/human-framework-legacy": "npm:@adam0white/human-framework@2.9.0",
    "@adam0white/human-framework-legacy3": "npm:@adam0white/human-framework@3.0.0",
    "@adam0white/lab-client": "https://github.com/adam0white/human-framework/releases/download/lab-client-v0.5.3/adam0white-lab-client-0.5.3.tgz",
    "@adam0white/lab-client-legacy3": "file:vendor/adam0white-lab-client-0.4.15.tgz",
    "@adam0white/lab-kit": "https://github.com/adam0white/human-framework/releases/download/lab-kit-v0.5.21/adam0white-lab-kit-0.5.21.tgz"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "26.6.5",
    "playwright-core": "1.64.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wrangler": "4.152.0"
  },
  "packageManager": "pnpm@12.14.0+sha512.c18ba6d87993d3d164cb5e8948f32b2c06ee854487e06cd8d86781342fb3e5bb4634367034711e86802baa9c37bea906ce1929ad08d70884c97d801df13389a6"
}
